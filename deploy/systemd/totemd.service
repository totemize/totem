[Unit]
Description=Totem control-plane daemon (totemd)
Wants=fips.service network-online.target
After=fips.service network-online.target

[Service]
Type=simple
User=totem
Group=totem
# systemd reads the root:root 0600 source and exposes a private, read-only
# credential to this unprivileged service. Source permissions stay intact.
LoadCredential=fips.key:/etc/fips/fips.key
NoNewPrivileges=true
EnvironmentFile=-/etc/totemd/totemd.env
ExecStart=/usr/local/bin/totemd serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
